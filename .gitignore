# Build artifacts produced by build.sh (reproducible; regenerate with ./build.sh).
# Only needed for binary (.srs) rule-set support. Remove these lines if you want
# to commit them so static hosting needs no Go at all (e.g. for GitHub Pages).
web/srs.wasm
web/srs.wasm.gz
web/wasm_exec.js

# wasm build scratch: patched copy of the sing module + its alternate module file
# (see build.sh). Regenerated on demand.
wasmbuild/.singtree/
go.wasm.mod
go.wasm.sum
